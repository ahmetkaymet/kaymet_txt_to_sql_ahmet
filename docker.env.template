# ===========================================
# AImet - Docker Environment Variables Template
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED: OpenAI API Configuration
# ===========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model Configuration
OPENAI_MODEL=gpt-4o
# Alternative models: gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo

# ===========================================
# REQUIRED: Oracle Database Configuration
# ===========================================
# Oracle Database Connection Details
ORACLE_USER=your_username
ORACLE_PASSWORD=your_password

# Oracle DSN (Data Source Name)
# Format: hostname:port/service_name
# Examples:
# ORACLE_DSN=192.168.1.100:1521/ORCL
# ORACLE_DSN=oracle-server:1521/HRDB
# ORACLE_DSN=localhost:1521/XE

ORACLE_DSN=your-oracle-host:1521/your-service-name

# ===========================================
# OPTIONAL: Application Configuration
# ===========================================
# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Configuration
VITE_API_URL=http://localhost:8000

# ===========================================
# OPTIONAL: Docker Configuration
# ===========================================
# Docker Compose Project Name
COMPOSE_PROJECT_NAME=aimet

# ===========================================
# SECURITY NOTES
# ===========================================
# 1. Never commit the actual .env file to version control
# 2. Keep your OpenAI API key secure and private
# 3. Use strong passwords for database connections
# 4. Regularly rotate your API keys and passwords
# 5. Consider using Docker secrets for production deployments

# ===========================================
# EXAMPLE CONFIGURATIONS
# ===========================================

# Example 1: Local Development
# OPENAI_API_KEY=sk-proj-abc123...
# ORACLE_USER=hr_user
# ORACLE_PASSWORD=secure_password
# ORACLE_DSN=192.168.1.100:1521/HRDB

# Example 2: Docker Development
# OPENAI_API_KEY=sk-proj-def456...
# ORACLE_USER=docker_user
# ORACLE_PASSWORD=docker_password
# ORACLE_DSN=oracle-db:1521/XE

# Example 3: Production (with Docker secrets)
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
# ORACLE_USER_FILE=/run/secrets/oracle_user
# ORACLE_PASSWORD_FILE=/run/secrets/oracle_password
# ORACLE_DSN=prod-oracle:1521/PRODDB
